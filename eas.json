{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_ALLOW_LOOPBACK": "1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      },
      "env": {
        "EXPO_PUBLIC_API_ALLOW_LOOPBACK": "1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      },
      "env": {
        "EXPO_PUBLIC_API_ALLOW_LOOPBACK": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
