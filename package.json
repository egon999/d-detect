    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.30.0",
    "typescript": "~5.9.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "expo-asset": "~55.0.20"
