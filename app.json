{
  "expo": {
    "name": "D-Detect",
    "slug": "ddetect",
    "scheme": "ddetect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dd.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030712",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddetect.casegraph",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.ddetect.casegraph",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#030712"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/dd.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/dd.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#030712",
          "dark": {
            "image": "./assets/dd.png",
            "backgroundColor": "#030712"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "D-Detect needs your photos so you can save a payment screenshot, a bill or a document and have it read for you.",
          "cameraPermission": "D-Detect needs your camera so you can photograph a bill or a document and have it read for you."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/with-release-signing.js",
      "./plugins/with-android-security.js",
      [
        "expo-audio",
        {
          "microphonePermission": "D-Detect needs your microphone so you can record a meeting and get the summary and the action items afterwards.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-notification-icon.png",
          "color": "#BEA860",
          "defaultChannel": "due-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": null
      },
      "firebase": {
        "apiKey": "AIzaSyC0Umg35kUiH1XOqb139TttQCTSF3Ut1hE",
        "authDomain": "d-dectect.firebaseapp.com",
        "projectId": "d-dectect",
        "storageBucket": "d-dectect.firebasestorage.app",
        "messagingSenderId": "398432738032",
        "appId": "1:398432738032:android:a2dd4c9a938c5b8b63c035"
      },
      "googleWebClientId": "398432738032-als9m6j3mfgdqup9ue4e77guva3cl2v9.apps.googleusercontent.com"
    }
  }
}
