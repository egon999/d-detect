{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.domain.json && node --check local-server.js && node --check index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prelocal": "npm run build",
    "local": "node local-server.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run local",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "cors": "^2.8.6",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
