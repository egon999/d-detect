{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "../src/domain",
    "outDir": "lib/domain",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  // Domain files the server runs. Each is here because the server must reach the *same*
  // answer as the device, not merely a similar one: `deterministic` and `report-entities`
  // because a re-extraction that read a document differently would rewrite quoted evidence,
  // and `hashing`/`audit-chain`/`seal` because the server signs the chain head the device
  // shows. Two implementations of that head would produce a seal that fails to verify
  // against the record it covers — so there is one implementation, compiled twice.
  "include": [
    "../src/domain/extraction/deterministic.ts",
    "../src/domain/analysis/report-entities.ts",
    "../src/domain/hashing.ts",
    "../src/domain/analysis/audit-chain.ts",
    "../src/domain/crucible/seal.ts",
    "../src/domain/crucible/keys.ts"
  ]
}
