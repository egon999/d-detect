# SERVER ONLY. Copy to .env.local; never use EXPO_PUBLIC_ for provider credentials.
FIREBASE_PROJECT_ID=d-dectect
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Image/PDF text is read locally by Tesseract OCR; no vision model is needed.
API_HOST=127.0.0.1
PORT=8787
# DATA_DIRECTORY defaults to functions/.data. Keep original files and database private.
# WEB_ORIGINS=https://your-app.example
# Auth emulator is test-only and requires loopback binding:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
