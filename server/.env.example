# detact server — environment template
#
# Copy this file to `server/.env` and fill in the values you need. Every secret this
# product uses is read here, on the server; the app ships with none. A missing .env is
# not fatal — the server still boots and `/health` reports what is absent.
#
# `server/.env` is git-ignored; this `.env.example` records only the SHAPE, never real
# values. Do NOT put real secrets in this file.
#
# Every name below is read by `src/env.ts`. A name documented here that no code reads is
# worse than an undocumented one: `FILE_LINK_SECRET` used to sit in this file describing
# signed, short-lived URLs for stored originals, and no such signing exists — a stored
# original is authorized by the account on the request and an owner match on the row.
# An operator who set it would have believed they had turned on a protection they did not
# have. If a name disappears from `src/env.ts`, delete it here in the same change.

# ── HTTP server ──────────────────────────────────────────────────────────────
# TCP port the API listens on. default: 8787
PORT=
# Interface to bind. default: 127.0.0.1 (loopback only)
HOST=

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for the SQLite db and stored originals, resolved relative to server/. default: .data
DATA_DIR=

# ── Browser access & uploads ───────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (CORS). Empty by default.
# Example: http://localhost:8081,http://localhost:8082
ALLOWED_ORIGINS=
# Largest upload accepted, in bytes. default: 26214400 (25 MiB)
MAX_UPLOAD_BYTES=

# ── AI: Groq (the only provider: text + vision + audio) ─────────────────────────
# Groq API key (gsk_... , groq.com). Free tier: text reasoning, image reading and
# Whisper transcription, all on this one key. Without it, transcription and analysis
# are offline and `/health` says so.
#
# A key of any other shape is treated as missing rather than passed through, because a
# key from the wrong console is a plausible-looking string that makes every readiness
# check say "configured" and every request come back rejected.
GROQ_API_KEY=
# Groq text/reasoning model. default: openai/gpt-oss-120b
GROQ_TEXT_MODEL=
# Groq Whisper transcription model. default: whisper-large-v3-turbo
GROQ_AUDIO_MODEL=
# Groq vision model. The text model refuses image parts, so this is a separate id.
# default: qwen/qwen3.8-27b
GROQ_VISION_MODEL=

# ── AI: deadlines, queue and budget ──────────────────────────────────────────────
# Wall-clock ceiling for a single text or image call, in milliseconds. default: 90000
# Clamped to 5000-600000: a typo here must not stop every model call in the product.
AI_TIMEOUT_MS=
# Ceiling for a single transcription, in milliseconds. default: 300000 (clamped 5000-900000)
# Separate from AI_TIMEOUT_MS because the length of a recording is not something the
# person can shorten, and a long meeting that times out costs them the whole file.
AI_TRANSCRIBE_TIMEOUT_MS=
# How many model calls this server may have in the air at once. default: 3 (clamped 1-16)
# The free tier counts requests per minute, so a burst of captures without a queue in
# front of it produces one success and nineteen records that say they could not be read.
AI_MAX_CONCURRENCY=
# Most characters of untrusted material handed to a model in one call, shared across
# every attachment in that call. default: 24000 (clamped 1000-200000)
# Longer text is truncated head-and-tail with a visible disclosure, never silently.
AI_MAX_TEXT_CHARS=
# Write one line per model call to stderr (no keys, no prompts, no model names).
# default: false. Failures are logged either way.
AI_LOG_CALLS=

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Firebase Web API key. Not a secret (it ships in every client); the server uses it to
# validate an ID token via identitytoolkit accounts:lookup.
FIREBASE_WEB_API_KEY=
# Dev only: accept an `x-device-id` header as the account id so the app works before
# sign-in is wired. Forced OFF when NODE_ENV=production. default: true (in dev)
DEV_ALLOW_DEVICE_IDENTITY=
# Runtime environment. Set to `production` to harden (e.g. device identity is refused).
# default: unset (development behavior)
NODE_ENV=
