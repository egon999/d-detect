# Copy to `.env` and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration → Config
#
# These are NOT secrets. The Firebase web config is a public project identifier. Data is
# protected by authenticated backend ownership checks (or Security Rules for the optional
# Firebase adapter), never by hiding these values. Expo inlines anything with
# that prefix into the app bundle.
#
# NEVER put a model-provider key (Groq, xAI/Grok, Gemini) or a service-account JSON in
# this file. EXPO_PUBLIC_ values are readable by anyone who unzips the APK. Provider API
# keys are never client env vars at all:
#
# - Users bring their own key (BYOK): they paste it once in Settings and it is stored in
#   the device keystore (Android Keystore / iOS Keychain), never in this file or the app
#   bundle.
# - Server-side keys for the optional functions backend belong only in the ignored
#   functions/.env.local or in Firebase secrets.
#
# The app supports both Groq and xAI (Grok) as AI providers.

# ---------------------------------------------------------------------------
# Optional platform backend — leave this commented out
# ---------------------------------------------------------------------------
# The shipping app runs entirely on the device. Evidence files are stored in the app's private
# directory, records go to Firestore (or AsyncStorage when signed out), and nothing needs to be
# running anywhere for the app to work.
#
# `functions/local-server.js` in this repository is an optional development service. It is not
# deployed: the Firebase project is on the Spark plan, which has no Cloud Functions.
#
# Setting this variable switches the entire data layer to `RemoteRepository`, which then
# expects that service at this address. Copying this file with the line uncommented — as an
# earlier revision shipped it — points a working app at a server nobody is running, and every
# read and write fails with a network error that looks like a bug in the app.
#
# Uncomment it only while that service is actually running.
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Enables the "Continue with Google" button. Taken from the `oauth_client` entry
# with `client_type: 3` in google-services.json, or the Web client ID in the Google Cloud
# credentials console. A client ID is public; the OAuth redirect is what authenticates.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. Routes Auth (:9099) and Firestore (:8080) at the local Emulator Suite.
#
# Accepts 1, true or yes, in any case. `EXPO_PUBLIC_USE_FIREBASE_EMULATORS` (plural) is read
# as a fallback, because both spellings have been in use.
#
# Not storage: evidence files go to Cloudinary or the on-device store, neither of which has
# an emulator. Files written while this is on are real uploads.
#
# Expo inlines these at build time, so changing this needs the dev server restarted
# (`npx expo start -c`) — a live reload will not pick it up.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=1

# Optional. Where the Emulator Suite is listening. Defaults to 127.0.0.1; set it to your
# machine's LAN address when running the app on a physical device, which cannot reach the
# host's loopback. Hostname or IP only — no scheme, no port.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# ---------------------------------------------------------------------------
# A note on APP_ID
# ---------------------------------------------------------------------------
# If you only have a google-services.json (an Android app), its `mobilesdk_app_id` works
# here: the JS SDK uses appId for Analytics and Installations, neither of which this app
# uses. Auth, Firestore and Storage key off apiKey, projectId and storageBucket. Registering
# a **Web** app in the console gives you a proper `1:…:web:…` id, which is tidier.
