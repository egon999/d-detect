# Copy to `.env` and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration → Config
#
# Not secrets: the Firebase web config is a public project identifier, and Expo inlines
# anything with the EXPO_PUBLIC_ prefix into the app bundle. Access is controlled by the
# server and by the security rules, never by hiding these values.
#
# Never put a model-provider key or a service-account JSON in this file. The server holds
# every provider key; the app never sees one.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Enables the "Continue with Google" button. The `oauth_client` entry with
# `client_type: 3` in google-services.json, or the Web client ID in the Google Cloud
# credentials console. A client ID is public; the OAuth redirect is what authenticates.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional, development only. Routes Auth (:9099) and Firestore (:8080) at the local
# Emulator Suite. Accepts 1, true or yes; `EXPO_PUBLIC_USE_FIREBASE_EMULATORS` (plural) is
# read as a fallback. Expo inlines it at build time, so restart with `npx expo start -c`
# after changing it. Leave it at 0 to use real Firebase.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0

# Optional. Where that Emulator Suite is listening. Empty means 127.0.0.1; set your
# machine's LAN address when running on a physical device, which cannot reach the host's
# loopback. Hostname or IP only — no scheme, no port. Never commit a value here.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Address of the server the app talks to. Without it the app falls back to
# `10.0.2.2:8787` on Android and `localhost:8787` elsewhere, which only resolve on an
# emulator or a machine running the server.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_ALLOW_LOOPBACK=

# A note on APP_ID: if you only have a google-services.json (an Android app), its
# `mobilesdk_app_id` works here. Auth, Firestore and Storage key off apiKey, projectId and
# storageBucket; appId is only used for Analytics and Installations, which this app does
# not use.
